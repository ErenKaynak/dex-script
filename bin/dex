#!/usr/bin/env bash
# dex - Samsung DeX in a resizable window on your PC (scrcpy virtual display).
# Linux / macOS, bash 3.2 compatible, no sudo.
set -uo pipefail

DEX_REPO="${DEX_REPO:-ErenKaynak/dex-script}"
ROOT="${DEX_HOME:-$HOME/.local/share/dex}"
SCRCPY="${DEX_SCRCPY:-$ROOT/scrcpy/scrcpy}"
ADB="${DEX_ADB:-$ROOT/scrcpy/adb}"
SERVER_PATCHED="${DEX_SERVER_PATCHED:-$ROOT/scrcpy/scrcpy-server-dex}" # built by .github/workflows/server.yml
CONFIG_DIR="${DEX_CONFIG_DIR:-$HOME/.config/dex}"
CONFIG="$CONFIG_DIR/config"
OS="$(uname -s)"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
  C_CYAN=$'\033[36m'; C_OFF=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_ERR=""; C_B=""; C_DIM=""; C_CYAN=""; C_OFF=""
fi
say() { printf '%s\n' "$*"; }
ok() { printf '%s✓%s %s\n' "$C_OK" "$C_OFF" "$*"; }
warn() { printf '%s! %s%s\n' "$C_WARN" "$*" "$C_OFF"; }
err() { printf '%s✗ %s%s\n' "$C_ERR" "$*" "$C_OFF" >&2; }
die() { err "$*"; exit 1; }

usage() {
  cat <<EOF
${C_B}dex${C_OFF} - Samsung DeX in a window on your PC

Usage: dex                       interactive menu (pick 1, 2, 3 ...)
       dex [command] [options] [-- extra scrcpy args]

Commands:
  dex code           start DeX, profile "code" (crisp text, coding, browser)
  dex school         start DeX, profile "school" (denser, Word/Excel side by side)
  dex movie          start DeX, profile "movie" (high bitrate, H.265)
  dex mirror         plain phone-screen mirror (no virtual display)
  dex pair           wireless pairing without a cable (once per PC; dex remembers the phone)
  dex connect [ip:port]  connect over Wi-Fi (no arg: auto-discover / remembered phone)
  dex wifi           switch a USB-connected phone to Wi-Fi
  dex wake           wake the phone / unfreeze a stuck DeX window
  dex keyboard       open phone keyboard settings (pick Turkish Q)
  dex doctor         show versions, devices and phone info
  dex debug          start DeX (code) and save a phone log for bug reports
  dex update         re-run the installer (latest scripts)
  dex uninstall      remove everything dex installed
  dex help           this text

Options (start commands):
  --res WxH          initial window size (default: 80% of your screen)
  --dpi N            DeX density (code 160, school 140, movie 160)
  --usb / --wifi     force the transport
  --screen on|dim|off  phone panel while DeX runs (default: on; see below)
  --screen-off       same as --screen off
  --fullscreen       start fullscreen at your monitor's resolution (native DeX feel)
  --no-freeform      skip the One UI 8.5+/9 windowing fix
  --display auto|overlay|virtual
                     overlay (default on One UI 8.5+/9 with the stock server): DeX runs on a
                     system overlay display, the only kind Android 16 QPR2+/17 gives real
                     desktop windows (title bars, drag, resize, minimize) with the stock
                     scrcpy server. Android shows a small preview of it on the phone screen.
                     virtual: scrcpy's own display (resizes with the window; on One UI
                     8.5+/9 it only gets title bars with the patched server).
  --server auto|patched|stock
                     patched (default when installed and Android 17+): dex's build of the
                     scrcpy server that creates the virtual display as desktop-capable
                     (scrcpy PR #7055), so --display virtual gets real windows and still
                     resizes with the window. stock: the server from the scrcpy release.
  --mouse uhid|sdk   uhid (default on Android 15+): real HID mouse on the DeX display,
                     DeX title bars drag like with a plugged-in mouse (Alt releases the
                     PC pointer). sdk: injected touch-style clicks, pointer not captured.
  --debug            save the phone log of this session to the config folder
  --                 pass everything after it to scrcpy

Phone screen: "on" is the safe default (DeX never freezes). "dim" keeps the panel
technically on but at minimum brightness and restores it afterwards. "off" turns the
panel off; on some Galaxy phones DeX then stops responding -> run: dex wake

Config: $CONFIG
  DEX_SCREEN, DEX_FULLSCREEN, DEX_RES, DEX_DPI, DEX_SHORTCUT_MOD, DEX_EXTRA_ARGS,
  DEX_FREEFORM, DEX_FREEFORM_SUPPORT (0|1, unset = leave the phone's value alone),
  DEX_DISPLAY (auto|overlay|virtual), DEX_SERVER (auto|patched|stock), DEX_MOUSE (uhid|sdk),
  DEX_MOUSE_ACCEL (0|1, default 0: phone mouse acceleration off while DeX runs with the uhid mouse),
  DEX_VIDEO_BUFFER (ms; Wi-Fi default 0 with the uhid mouse, 50 with sdk),
  DEX_IME (hide|local|fallback|default; default hide: no on-screen keyboard on the DeX screen),
  DEX_FORCE_DESKTOP (1 = also set force_desktop_mode_on_external_displays while DeX runs),
  DEX_LAST_ENDPOINT, DEX_LAST_IP, DEX_PHONE_NAME, DEX_PHONE_SERIAL (remembered phone)
EOF
}

# --- config -------------------------------------------------------------------
cfg_get() { # cfg_get KEY
  local v=""
  if [ -f "$CONFIG" ]; then v="$(grep "^$1=" "$CONFIG" | tail -n 1 | cut -d= -f2- || true)"; fi
  v="${v%\"}"; v="${v#\"}"
  printf '%s' "$v"
}
cfg_set() { # cfg_set KEY VALUE
  mkdir -p "$CONFIG_DIR"
  local tmp="$CONFIG.tmp.$$"
  { if [ -f "$CONFIG" ]; then grep -v "^$1=" "$CONFIG" || true; fi; } > "$tmp"
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$CONFIG"
}

# --- adb helpers ------------------------------------------------------------------
need_tools() {
  [ -x "$ADB" ] || die "adb not found at $ADB. Run the installer again (dex update)."
  [ -x "$SCRCPY" ] || [ "${DEX_DRY_RUN:-0}" = "1" ] || die "scrcpy not found at $SCRCPY. Run the installer again (dex update)."
}

is_tcp() { case "$1" in *:*|*._adb-tls-connect._tcp*) return 0 ;; *) return 1 ;; esac; }

# Fills USB_LIST / TCP_LIST (newline separated serials in state "device"), UNAUTH and NOPERM.
scan_devices() {
  USB_LIST=""; TCP_LIST=""; UNAUTH=""; NOPERM=""
  local serial state rest
  while read -r serial state rest; do
    [ -n "$serial" ] || continue
    case "$serial" in "List"|"*") continue ;; esac
    case "$state" in
      device)
        if is_tcp "$serial"; then TCP_LIST="$TCP_LIST$serial"$'\n'; else USB_LIST="$USB_LIST$serial"$'\n'; fi ;;
      unauthorized) UNAUTH="$UNAUTH$serial"$'\n' ;;
      no) NOPERM="$NOPERM$serial"$'\n' ;; # "no permissions (missing udev rules?)"
    esac
  done < <("$ADB" devices -l 2>/dev/null || true)
}
first_line() { printf '%s' "$1" | head -n 1; }
count_lines() { printf '%s' "$1" | grep -c . || true; }

connected_ok() { grep -qi "connected to"; }

save_endpoint() { # save_endpoint IP:PORT - remember where the phone was reached over Wi-Fi
  cfg_set DEX_LAST_ENDPOINT "$1"
  cfg_set DEX_LAST_IP "${1%:*}"
}
# The phone keeps the PC's pairing key, so pairing is needed once per PC. What changes is the
# connect port (every Wireless debugging restart / phone reboot), so dex remembers the phone and
# only needs the new port, never the pairing code again.
mdns_connect() { # try auto-discovered wireless debugging endpoint; 0 on success
  local list ep serial
  list="$("$ADB" mdns services 2>/dev/null | awk '/_adb-tls-connect\._tcp/ {print $1, $NF}' || true)"
  [ -n "$list" ] || return 1
  serial="$(cfg_get DEX_PHONE_SERIAL)"
  ep=""
  if [ -n "$serial" ]; then ep="$(printf '%s\n' "$list" | grep -F -- "$serial" | awk '{print $2; exit}' || true)"; fi
  [ -n "$ep" ] || ep="$(printf '%s\n' "$list" | awk '{print $2; exit}')"
  [ -n "$ep" ] || return 1
  say "Found phone via mDNS: $ep"
  if "$ADB" connect "$ep" 2>&1 | connected_ok; then
    save_endpoint "$ep"
    return 0
  fi
  return 1
}
saved_connect() {
  local ep
  ep="$(cfg_get DEX_LAST_ENDPOINT)"
  [ -n "$ep" ] || return 1
  say "Trying last endpoint $ep ..."
  "$ADB" connect "$ep" 2>&1 | connected_ok
}
remembered_phone() { # prints "Galaxy S25 (last at 192.168.1.5)" or nothing
  local name ip
  name="$(cfg_get DEX_PHONE_NAME)"; ip="$(cfg_get DEX_LAST_IP)"
  [ -n "$name$ip" ] || return 1
  printf '%s' "${name:-phone}"
  [ -n "$ip" ] && printf ' (last at %s)' "$ip"
  return 0
}
# Ask only for the new connect port of a remembered phone (interactive terminals only).
prompt_reconnect() {
  local ip ep port
  ip="$(cfg_get DEX_LAST_IP)"
  [ -n "$ip" ] && [ -t 0 ] && [ "${DEX_NO_TUI:-0}" != 1 ] || return 1
  say "Remembered phone: $(remembered_phone). The pairing is kept; only the port changes."
  say "Phone > Developer options > Wireless debugging > \"IP address & Port\" (Enter = skip)"
  read -r -p "Port or IP:port: " port || true
  [ -n "$port" ] || return 1
  case "$port" in *:*) ep="$port" ;; *) ep="$ip:$port" ;; esac
  if "$ADB" connect "$ep" 2>&1 | connected_ok; then save_endpoint "$ep"; return 0; fi
  warn "Could not connect to $ep."
  return 1
}
# Remember the connected phone (name + serial) so later sessions find it without pairing again.
remember_phone() {
  local name serial
  serial="$(phone_shell getprop ro.serialno)"
  [ -n "$serial" ] || return 0
  [ "$serial" = "$(cfg_get DEX_PHONE_SERIAL)" ] && return 0
  name="$(phone_shell getprop ro.product.marketname)"
  [ -n "$name" ] || name="$(phone_shell getprop ro.product.model)"
  cfg_set DEX_PHONE_SERIAL "$serial"
  [ -n "$name" ] && cfg_set DEX_PHONE_NAME "$name"
  return 0
}

no_device_help() {
  if [ -n "${NOPERM:-}" ]; then
    err "The phone is plugged in but Linux blocks USB access (missing udev rule). Fix once, then replug:"
    cat >&2 <<EOF
  Debian/Ubuntu:  sudo apt install android-sdk-platform-tools-common
  Other distros:  echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", TAG+="uaccess"' | sudo tee /etc/udev/rules.d/51-android.rules
                  sudo udevadm control --reload-rules
  (Or skip USB: dex pair)
EOF
    return
  fi
  err "No phone found."
  local rp
  if rp="$(remembered_phone)"; then
    cat >&2 <<EOF
Remembered: $rp. It is already paired with this PC: no code needed.
  1. Plug in the USB cable, or
  2. dex connect - type the current port from Wireless debugging ("IP address & Port").
     (Wireless debugging must be ON and the phone on the same Wi-Fi.)
  3. dex pair    - only if the phone forgot this PC (Wireless debugging > Paired devices).
EOF
    return
  fi
  cat >&2 <<EOF
Options:
  1. Plug in the USB cable (and accept "Allow USB debugging" on the phone).
  2. dex pair   - pair wirelessly (Wireless debugging), no cable needed. Once per PC.
  3. dex wifi   - with the cable plugged in, switch the connection to Wi-Fi.
EOF
}
unauth_help() {
  err "Phone $(first_line "$UNAUTH") is unauthorized: accept the \"Allow USB debugging\" prompt on the phone, then retry."
}

# select_device MODE(auto|usb|wifi) -> sets SERIAL, TRANSPORT (usb|wifi); returns 2 if none
select_device() {
  local mode="$1"
  SERIAL=""; TRANSPORT=""
  scan_devices
  if [ "$mode" != "wifi" ] && [ -n "$USB_LIST" ]; then
    SERIAL="$(first_line "$USB_LIST")"; TRANSPORT=usb
    if [ "$(count_lines "$USB_LIST")" -gt 1 ]; then say "Several USB devices; using $SERIAL"; fi
    return 0
  fi
  if [ "$mode" = "usb" ]; then
    if [ -n "$UNAUTH" ]; then unauth_help; fi
    no_device_help; return 2
  fi
  if [ -z "$TCP_LIST" ]; then
    if mdns_connect || saved_connect || prompt_reconnect; then scan_devices; fi
  fi
  if [ -n "$TCP_LIST" ]; then
    SERIAL="$(first_line "$TCP_LIST")"; TRANSPORT=wifi
    if [ "$(count_lines "$TCP_LIST")" -gt 1 ]; then say "Several Wi-Fi devices; using $SERIAL"; fi
    return 0
  fi
  if [ -n "$UNAUTH" ]; then unauth_help; fi
  no_device_help; return 2
}

# phone_shell CMD... : adb shell on $SERIAL, CRs stripped, never fails the script
phone_shell() { "$ADB" -s "$SERIAL" shell "$@" 2>/dev/null | tr -d '\r' || true; }

# --- phone state --------------------------------------------------------------------
# One UI 8.5 / 9 (Android 16 QPR2+) no longer enables desktop windowing on app-created
# virtual displays: DeX starts, but every app opens fullscreen and cannot be moved or
# resized. The per-display windowing mode can be forced with a shell command
# (5 = WINDOWING_MODE_FREEFORM). On One UI 8.0 the command does not exist and is not needed.
enable_freeform() { # enable_freeform DISPLAY_ID
  [ "${FREEFORM:-1}" = 1 ] || return 0
  if "$ADB" -s "$SERIAL" shell wm set-display-windowing-mode -d "$1" 5 >/dev/null 2>&1; then
    ok "Desktop windowing enabled on DeX display $1 (apps open as movable windows)."
  else
    say "${C_DIM}Display $1: windowing-mode command not available (One UI 8.0?), freeform should already be on.${C_OFF}"
  fi
}

# Wake a sleeping/dozing phone: scrcpy 5.0.1 does not do it for a new virtual display, and a
# dozing Galaxy never renders the DeX display (you see nothing or a frozen frame).
wake_phone() {
  local wk
  wk="$(phone_shell dumpsys power | sed -n 's/.*mWakefulness=\([A-Za-z]*\).*/\1/p' | head -n 1)"
  case "$wk" in
    Asleep|Dozing) say "Waking the phone..."; phone_shell input keyevent KEYCODE_WAKEUP >/dev/null; sleep 1 ;;
  esac
  if phone_shell dumpsys window policy | awk '/KeyguardServiceDelegate/{f=1} f && /showing=true/{found=1; exit} END{exit !found}'; then
    warn "The phone is locked. Unlock it, or DeX shows only the lock screen (Samsung also hides the dock while locked)."
  fi
}

# Phone panel while DeX runs. "dim": minimum brightness, restored on exit (safe on every
# Galaxy). "off": scrcpy turns the panel off; some Galaxy phones then doze and the DeX
# window freezes (dex wake recovers).
SAVED_BRI=""; SAVED_BRI_MODE=""
dim_on() {
  SAVED_BRI="$(phone_shell settings get system screen_brightness)"
  SAVED_BRI_MODE="$(phone_shell settings get system screen_brightness_mode)"
  phone_shell settings put system screen_brightness_mode 0 >/dev/null
  phone_shell settings put system screen_brightness 0 >/dev/null
  say "${C_DIM}Phone screen dimmed (restored when DeX closes).${C_OFF}"
}
dim_off() {
  case "$SAVED_BRI" in [0-9]*) phone_shell settings put system screen_brightness "$SAVED_BRI" >/dev/null ;; esac
  case "$SAVED_BRI_MODE" in [0-9]*) phone_shell settings put system screen_brightness_mode "$SAVED_BRI_MODE" >/dev/null ;; esac
  SAVED_BRI=""; SAVED_BRI_MODE=""
}

# The "Enable freeform windows" developer option (global enable_freeform_support), set for the
# session and restored on exit. One UI 8.0 builds may need it on. On One UI 8.5+/9 the phone's
# value is left alone: the framework only reads it at boot (ATMS mSupportsFreeformWindowManagement),
# so flipping it per session cannot help and the earlier "keep it off" idea was wrong (the inert
# title bars it produced were the app-side legacy caption, see DESIGN.md).
SAVED_FREEFORM_SUPPORT=""
freeform_support_set() { # freeform_support_set 0|1|"" ("" = leave alone)
  local cur
  case "$1" in 0|1) ;; *) return 0 ;; esac
  cur="$(phone_shell settings get global enable_freeform_support)"
  case "$cur" in
    "$1"|"") return 0 ;; # already right, or unreadable
    null) [ "$1" = 1 ] || return 0 ;; # unset means off
  esac
  SAVED_FREEFORM_SUPPORT="$cur"
  phone_shell settings put global enable_freeform_support "$1" >/dev/null
  if [ "$1" = 0 ]; then
    say "${C_DIM}Freeform developer option off while DeX runs (it breaks window dragging on One UI 8.5+).${C_OFF}"
  fi
}
want_freeform_support() { # prints 0|1|"": config DEX_FREEFORM_SUPPORT, else 1 below One UI 8.5, else ""
  local v
  v="$(cfg_get DEX_FREEFORM_SUPPORT)"
  case "$v" in 0|1) echo "$v"; return ;; esac
  v="$(phone_shell getprop ro.build.version.oneui)"
  case "$v" in [0-9]*) [ "$v" -ge 80500 ] && { echo ""; return; } ;; esac
  echo 1
}

# --- overlay display ------------------------------------------------------------------------
# Android 16 QPR2+/17 (One UI 8.5+/9) runs desktop windowing (title bars, drag, resize, minimize)
# only on displays whose content mode can switch between mirror and extend
# (DisplayContent.isEligibleForDesktopMode -> allowContentModeSwitch). scrcpy's virtual display is
# created with "always show system decorations", which excludes it: WM Shell logs "desktop not
# supported" and never decorates the windows. A system *overlay* display (developer setting
# overlay_display_devices) is eligible, DeX manages it like an external monitor, and scrcpy mirrors
# it with --display-id. Cost: Android draws a small preview of it on the phone screen, and its size
# is fixed for the session (no --flex-display).
OVERLAY_ID=""
overlay_create() { # overlay_create WxH DPI -> sets OVERLAY_ID; 1 if the display never appeared
  local i=0 id=""
  phone_shell settings put global overlay_display_devices "$1/$2" >/dev/null
  while [ $i -lt 40 ]; do
    id="$(phone_shell dumpsys display | grep 'type OVERLAY' | sed -n 's/.*displayId \([0-9]*\),.*/\1/p' | head -n 1)"
    if [ -n "$id" ]; then OVERLAY_ID="$id"; return 0; fi
    sleep 0.25; i=$((i+1))
  done
  phone_shell settings delete global overlay_display_devices >/dev/null
  return 1
}
overlay_destroy() {
  [ -n "$OVERLAY_ID" ] || return 0
  phone_shell settings delete global overlay_display_devices >/dev/null
  OVERLAY_ID=""
}
# Patched scrcpy server (server/0001-allows-content-mode-switch.patch, built by CI): on Android 17+
# it creates the virtual display with ALLOWS_CONTENT_MODE_SWITCH instead of "always show system
# decorations", which makes it desktop-eligible, so the virtual display gets real windows AND keeps
# --flex-display resizing, with no preview on the phone. scrcpy picks it up via SCRCPY_SERVER_PATH.
SERVER_MODE=stock
want_server() { # prints patched|stock: --server, config DEX_SERVER, else patched when installed and SDK >= 37
  local v sdk
  v="${OPT_SERVER:-$(cfg_get DEX_SERVER)}"
  case "$v" in
    stock) echo stock; return ;;
    patched) if [ -f "$SERVER_PATCHED" ]; then echo patched; else warn "Patched server not installed ($SERVER_PATCHED): run dex update. Using the stock server." >&2; echo stock; fi; return ;;
  esac
  [ -f "$SERVER_PATCHED" ] || { echo stock; return; }
  sdk="$(phone_shell getprop ro.build.version.sdk)"
  case "$sdk" in [0-9]*) [ "$sdk" -ge 37 ] && { echo patched; return; } ;; esac
  echo stock
}
want_display() { # prints overlay|virtual: --display, config DEX_DISPLAY, else by server / One UI / Android version
  local v ui sdk
  v="${OPT_DISPLAY:-$(cfg_get DEX_DISPLAY)}"
  case "$v" in overlay|virtual) echo "$v"; return ;; esac
  [ "$SERVER_MODE" != patched ] || { echo virtual; return; } # the patched server makes the virtual display desktop-capable
  ui="$(phone_shell getprop ro.build.version.oneui)"
  case "$ui" in
    [0-9]*) if [ "$ui" -ge 80500 ]; then echo overlay; else echo virtual; fi; return ;;
  esac
  sdk="$(phone_shell getprop ro.build.version.sdk)"
  case "$sdk" in [0-9]*) [ "$sdk" -ge 37 ] && { echo overlay; return; } ;; esac
  echo virtual
}
freeform_support_off() {
  case "$SAVED_FREEFORM_SUPPORT" in
    "") ;;
    null) phone_shell settings delete global enable_freeform_support >/dev/null ;;
    *) phone_shell settings put global enable_freeform_support "$SAVED_FREEFORM_SUPPORT" >/dev/null ;;
  esac
  SAVED_FREEFORM_SUPPORT=""
}

# Opt-in (config DEX_FORCE_DESKTOP=1): the AOSP "force desktop mode on external displays"
# developer setting, set for the session and restored on exit. Makes Android treat the virtual
# display like an external monitor (full desktop mode) on builds where the windowing-mode fix
# alone leaves inert title bars. Not on by default: on One UI 9 the external-display path is
# where sam1am/localdex saw SystemUI crash on title bar drags.
SAVED_FORCE_DESKTOP=""
force_desktop_on() {
  [ "$(cfg_get DEX_FORCE_DESKTOP)" = 1 ] || return 0
  local cur
  cur="$(phone_shell settings get global force_desktop_mode_on_external_displays)"
  case "$cur" in 1|"") return 0 ;; esac
  SAVED_FORCE_DESKTOP="$cur"
  phone_shell settings put global force_desktop_mode_on_external_displays 1 >/dev/null
  say "${C_DIM}force_desktop_mode_on_external_displays=1 while DeX runs (DEX_FORCE_DESKTOP).${C_OFF}"
}
force_desktop_off() {
  case "$SAVED_FORCE_DESKTOP" in
    "") ;;
    null) phone_shell settings delete global force_desktop_mode_on_external_displays >/dev/null ;;
    *) phone_shell settings put global force_desktop_mode_on_external_displays "$SAVED_FORCE_DESKTOP" >/dev/null ;;
  esac
  SAVED_FORCE_DESKTOP=""
}

# Mouse mode. "uhid" = scrcpy creates a real HID mouse on the phone and binds it to the DeX
# display (Android 15+): DeX gets the same events as a mouse plugged into a DeX dock, so title bar
# drags, window buttons and edge resizing behave like native DeX. "sdk" injects clicks through the
# Android API; left clicks arrive as *touchscreen* finger events, which One UI 8.5+'s window
# decorations handle as touch (tap-and-hold to move) and partly ignore.
want_mouse() { # prints uhid|sdk: --mouse, config DEX_MOUSE, else uhid on Android 15+
  local v sdk
  v="${OPT_MOUSE:-$(cfg_get DEX_MOUSE)}"
  case "$v" in uhid|sdk) echo "$v"; return ;; esac
  sdk="$(phone_shell getprop ro.build.version.sdk)"
  case "$sdk" in [0-9]*) [ "$sdk" -ge 35 ] && { echo uhid; return; } ;; esac
  echo sdk
}
mod_name() { # human name of the shortcut mod
  case "$1" in lsuper|rsuper) echo "Cmd" ;; lctrl|rctrl) echo "Ctrl" ;; *) echo "Alt" ;; esac
}

# Android's mouse acceleration (Android 16+ setting, applied live) computes speed from event
# timestamps. Over Wi-Fi the HID mouse moves reach the phone in bursts with almost the same
# timestamp, so Android sees a very fast flick and throws the pointer across the screen
# ("teleporting"). Off for the session with the uhid mouse (config DEX_MOUSE_ACCEL=1 keeps it),
# restored on exit. The PC already applies its own pointer acceleration.
SAVED_MOUSE_ACCEL=""
mouse_accel_off() {
  [ "$(cfg_get DEX_MOUSE_ACCEL)" = 1 ] && return 0
  local cur
  cur="$(phone_shell settings get system mouse_pointer_acceleration_enabled)"
  case "$cur" in 0|"") return 0 ;; esac # already off, or unreadable
  SAVED_MOUSE_ACCEL="$cur"
  phone_shell settings put system mouse_pointer_acceleration_enabled 0 >/dev/null
  say "${C_DIM}Phone mouse acceleration off while DeX runs (smooth pointer over Wi-Fi; DEX_MOUSE_ACCEL=1 keeps it).${C_OFF}"
}
mouse_accel_restore() {
  case "$SAVED_MOUSE_ACCEL" in
    "") ;;
    null) phone_shell settings delete system mouse_pointer_acceleration_enabled >/dev/null ;;
    *) phone_shell settings put system mouse_pointer_acceleration_enabled "$SAVED_MOUSE_ACCEL" >/dev/null ;;
  esac
  SAVED_MOUSE_ACCEL=""
}

restore_phone() { dim_off; freeform_support_off; force_desktop_off; overlay_destroy; mouse_accel_restore; }

# --- screen size --------------------------------------------------------------------
detect_screen() { # prints "WxH" or nothing
  local wh=""
  if [ "$OS" = "Darwin" ]; then
    local sp
    sp="$(system_profiler SPDisplaysDataType 2>/dev/null || true)"
    wh="$(printf '%s\n' "$sp" | sed -n 's/.*UI Looks like: *\([0-9]*\) x \([0-9]*\).*/\1x\2/p' | head -n 1)"
    [ -n "$wh" ] || wh="$(printf '%s\n' "$sp" | sed -n 's/.*Resolution: *\([0-9]*\) x \([0-9]*\).*/\1x\2/p' | head -n 1)"
  elif command -v xrandr >/dev/null 2>&1; then
    local xr
    xr="$(xrandr --current 2>/dev/null || true)"
    wh="$(printf '%s\n' "$xr" | grep ' connected primary' | sed -n 's/.* \([0-9][0-9]*x[0-9][0-9]*\)+.*/\1/p' | head -n 1)"
    [ -n "$wh" ] || wh="$(printf '%s\n' "$xr" | grep ' connected' | sed -n 's/.* \([0-9][0-9]*x[0-9][0-9]*\)+.*/\1/p' | head -n 1)"
  fi
  if [ -z "$wh" ] && [ "$OS" != "Darwin" ] && command -v xdpyinfo >/dev/null 2>&1; then
    wh="$(xdpyinfo 2>/dev/null | sed -n 's/.*dimensions: *\([0-9]*x[0-9]*\) .*/\1/p' | head -n 1)"
  fi
  printf '%s' "$wh"
}
default_res() { # default_res PERCENT
  local wh w h pct="$1"
  wh="$(detect_screen)"
  case "$wh" in
    [0-9]*x[0-9]*)
      w=$(( ${wh%x*} * pct / 100 / 8 * 8 )); h=$(( ${wh#*x} * pct / 100 / 8 * 8 ))
      if [ "$w" -ge 640 ] && [ "$h" -ge 480 ]; then printf '%sx%s' "$w" "$h"; return; fi ;;
  esac
  if [ "$pct" -ge 100 ]; then printf '1920x1080'; else printf '1600x900'; fi
}

profile_dpi() { case "$1" in school) echo 140 ;; *) echo 160 ;; esac; }
profile_desc() {
  case "$1" in
    code) echo "crisp text: coding, T3, browser" ;;
    school) echo "more room: Word / Excel side by side" ;;
    movie) echo "high bitrate, H.265, smooth audio" ;;
    mirror) echo "plain phone screen, no DeX" ;;
  esac
}

# Runs scrcpy, applies the freeform fix as soon as the virtual display exists, returns scrcpy's
# exit code. The reader ignores Ctrl+C so it keeps draining until scrcpy has exited.
run_scrcpy() {
  "$SCRCPY" "$@" 2>&1 | (
    trap '' INT
    while IFS= read -r line; do
      printf '%s\n' "$line"
      case "$line" in
        *"New display:"*"(id="*)
          id="${line##*(id=}"; id="${id%%)*}"
          enable_freeform "$id"
          if [ -n "${DEBUG_LOG:-}" ]; then
            { printf '\n==== dumpsys window displays (display %s, after the freeform fix) ====\n' "$id"
              phone_shell dumpsys window displays; } >> "$DEBUG_LOG.dumpsys" 2>/dev/null
          fi ;;
      esac
    done
  )
  return "${PIPESTATUS[0]}"
}

# Bug-report log: phone logcat for the whole session + window manager dumps. Open an app, try to
# drag its title bar and press its buttons, then close DeX and send the files.
DEBUG_LOG=""; LOGCAT_PID=""
debug_start() {
  mkdir -p "$CONFIG_DIR"
  DEBUG_LOG="$CONFIG_DIR/debug-$(date +%Y%m%d-%H%M%S).log"
  { say "dex debug $(date)"; say "scrcpy: $*"; say "phone: $(phone_shell getprop ro.product.model) One UI $(phone_shell getprop ro.build.version.oneui) SDK $(phone_shell getprop ro.build.version.sdk)"
    say "settings: freeform_support=$(phone_shell settings get global enable_freeform_support) force_desktop=$(phone_shell settings get global force_desktop_mode_on_external_displays)"
  } > "$DEBUG_LOG"
  if [ -n "$OVERLAY_ID" ]; then
    { printf '==== dumpsys window displays (overlay display %s, before scrcpy) ====\n' "$OVERLAY_ID"
      phone_shell dumpsys window displays; } >> "$DEBUG_LOG.dumpsys" 2>/dev/null
  fi
  "$ADB" -s "$SERIAL" logcat -c >/dev/null 2>&1 || true
  "$ADB" -s "$SERIAL" logcat -v threadtime '*:D' >> "$DEBUG_LOG" 2>&1 &
  LOGCAT_PID=$!
  say "${C_WARN}Debug log: $DEBUG_LOG (open an app, drag its title bar, press its buttons, then close DeX)${C_OFF}"
}
debug_stop() {
  [ -n "$DEBUG_LOG" ] || return 0
  { printf '\n==== dumpsys window windows (at exit) ====\n'; phone_shell dumpsys window windows
    printf '\n==== dumpsys activity activities (at exit) ====\n'; phone_shell dumpsys activity activities
  } >> "$DEBUG_LOG.dumpsys" 2>/dev/null
  if [ -n "$LOGCAT_PID" ]; then kill "$LOGCAT_PID" 2>/dev/null; wait "$LOGCAT_PID" 2>/dev/null; fi
  grep -i -E 'ShellDesktopMode|DesktopMode|wmshell|FATAL|AndroidRuntime|DexCaption|Caption' "$DEBUG_LOG" > "$DEBUG_LOG.filtered" 2>/dev/null || true
  ok "Debug log saved: $DEBUG_LOG (+ .dumpsys, .filtered). Send these files with your bug report."
  DEBUG_LOG=""; LOGCAT_PID=""
}

# --- start -------------------------------------------------------------------------
start() { # start PROFILE -> returns 0 ok, 1 error, 2 no device
  local profile="$1"
  need_tools
  select_device "$MODE" || return 2
  if [ -z "$(cfg_get DEX_KEYBOARD_HINT_SHOWN)" ]; then
    say "Tip: for the Turkish Q layout run 'dex keyboard' once (physical keyboard settings on the phone)."
    cfg_set DEX_KEYBOARD_HINT_SHOWN 1
  fi

  local dpi bitrate res codec="h264" mod screen fullscreen mouse display
  local extra_profile=()
  case "$profile" in
    code) bitrate=16 ;;
    school) bitrate=12 ;;
    movie)
      bitrate=24; codec=h265; extra_profile=(--audio-buffer=80)
      say "Netflix / Disney+ / Prime use DRM: video stays black inside a PC window (Android"
      say "blocks capture of protected content). For DRM content use a USB-C to HDMI cable/hub to a"
      say "monitor/TV (real DeX), Wireless DeX to a smart TV, or the streaming site in the PC's"
      say "browser. YouTube, local files, Plex/Jellyfin work fine here." ;;
    mirror) bitrate=12 ;;
  esac
  if [ "$TRANSPORT" = "wifi" ]; then bitrate=$(( bitrate / 2 )); fi

  fullscreen="${OPT_FULLSCREEN:-$(cfg_get DEX_FULLSCREEN)}"
  res="${OPT_RES:-$(cfg_get DEX_RES)}"
  if [ -z "$res" ]; then
    if [ "$fullscreen" = 1 ]; then res="$(default_res 100)"; else res="$(default_res 80)"; fi
  fi
  dpi="${OPT_DPI:-$(cfg_get DEX_DPI)}"
  [ -n "$dpi" ] || dpi="$(profile_dpi "$profile")"
  mod="$(cfg_get DEX_SHORTCUT_MOD)"
  if [ -z "$mod" ]; then
    if [ "$OS" = "Darwin" ]; then mod=lsuper; else mod=lalt; fi
  fi
  screen="${OPT_SCREEN:-$(cfg_get DEX_SCREEN)}"
  case "$screen" in on|dim|off) ;; *) screen=on ;; esac
  FREEFORM="${OPT_FREEFORM:-$(cfg_get DEX_FREEFORM)}"
  [ "$FREEFORM" = 0 ] || FREEFORM=1
  [ "$profile" != "mirror" ] || FREEFORM=0 # no virtual display to fix

  mouse="$(want_mouse)"
  SERVER_MODE=stock
  display=virtual
  if [ "$profile" != "mirror" ]; then
    SERVER_MODE="$(want_server)"
    display="$(want_display)"
  fi

  local args=(-s "$SERIAL")
  if [ "$profile" != "mirror" ]; then
    if [ "$display" = overlay ]; then
      args+=("--display-id=OVERLAY") # replaced by the real id once the overlay display exists
    else
      args+=("--new-display=$res/$dpi" --flex-display --no-vd-destroy-content)
    fi
    args+=(--keyboard=uhid "--mouse=$mouse" --mouse-bind=++++:bhsn)
    # The PC keyboard is a real (UHID) keyboard, so the phone's on-screen keyboard is never
    # needed on the DeX screen; Samsung Keyboard would still pop up for every text field.
    # "hide" keeps typing working (key events go straight to the app). scrcpy restores the
    # display's policy on exit. DEX_IME=local|fallback shows it, default leaves Android's choice.
    local ime
    ime="$(cfg_get DEX_IME)"
    case "$ime" in local|fallback|hide) ;; default) ime="" ;; *) ime=hide ;; esac
    if [ -n "$ime" ]; then args+=("--display-ime-policy=$ime"); fi
  fi
  args+=("--window-title=Galaxy DeX ($profile)" "--shortcut-mod=$mod")
  # --keep-active: simulated user activity keeps the phone from sleeping on USB *and* Wi-Fi
  # (a sleeping phone stops rendering the DeX display). --stay-awake only works when plugged in.
  args+=(--keep-active --disable-screensaver --max-fps=60 "--video-bit-rate=${bitrate}M")
  if [ "$TRANSPORT" = "usb" ]; then args+=(--stay-awake); fi
  if [ "$TRANSPORT" = "wifi" ]; then
    # A video buffer absorbs Wi-Fi jitter, but with the uhid mouse the pointer is drawn by the
    # phone and travels inside the video, so every ms of buffer is pointer lag. 0 then; 50 ms
    # with the sdk mouse (local PC pointer). DEX_VIDEO_BUFFER overrides.
    local vbuf
    vbuf="$(cfg_get DEX_VIDEO_BUFFER)"
    case "$vbuf" in
      [0-9]*) ;;
      *) if [ "$profile" != mirror ] && [ "$mouse" = uhid ]; then vbuf=0; else vbuf=50; fi ;;
    esac
    if [ "$vbuf" != 0 ]; then args+=("--video-buffer=$vbuf"); fi
  fi
  if [ "$profile" = "mirror" ]; then
    args+=(--keyboard=uhid)
  else
    args+=("--video-codec=$codec")
    if [ "${#extra_profile[@]}" -gt 0 ]; then args+=("${extra_profile[@]}"); fi
  fi
  if [ "$screen" = off ]; then args+=(--turn-screen-off); fi
  if [ "$fullscreen" = 1 ]; then args+=(--fullscreen); fi

  local cfg_extra tok
  cfg_extra="$(cfg_get DEX_EXTRA_ARGS)"
  if [ -n "$cfg_extra" ]; then
    # Quote-aware split ("--window-title='My DeX'" stays one argument), no globbing, no eval.
    while IFS= read -r tok; do [ -n "$tok" ] && args+=("$tok"); done < <(printf '%s\n' "$cfg_extra" | xargs printf '%s\n' 2>/dev/null)
  fi
  if [ "${#OPT_RAW[@]}" -gt 0 ]; then args+=("${OPT_RAW[@]}"); fi

  export ADB
  if [ "$SERVER_MODE" = patched ]; then export SCRCPY_SERVER_PATH="$SERVER_PATCHED"; else unset SCRCPY_SERVER_PATH; fi
  if [ "${DEX_DRY_RUN:-0}" = "1" ]; then
    [ "$SERVER_MODE" != patched ] || printf 'SCRCPY_SERVER_PATH=%q ' "$SERVER_PATCHED"
    printf 'scrcpy'; printf ' %q' "${args[@]}"; printf '\n'
    return 0
  fi

  cfg_set DEX_LAST_PROFILE "$profile"
  remember_phone
  wake_phone
  if [ "$FREEFORM" = 1 ]; then freeform_support_set "$(want_freeform_support)"; force_desktop_on; fi
  if [ "$profile" != mirror ] && [ "$mouse" = uhid ]; then mouse_accel_off; fi
  if [ "$screen" = dim ]; then dim_on; fi
  trap 'restore_phone; debug_stop' INT TERM # Ctrl+C: scrcpy exits on its own, we just clean up
  if [ "$display" = overlay ]; then
    if overlay_create "$res" "$dpi"; then
      ok "Overlay display $OVERLAY_ID created ($res @ $dpi dpi): DeX runs on it like on an external monitor."
      say "${C_DIM}Android shows a small preview of it on the phone screen; ignore it. Size is fixed for this session (r = change).${C_OFF}"
      [ "$FREEFORM" = 1 ] && enable_freeform "$OVERLAY_ID"
      local i
      for i in "${!args[@]}"; do [ "${args[$i]}" = "--display-id=OVERLAY" ] && args[i]="--display-id=$OVERLAY_ID"; done
    else
      warn "Could not create the overlay display; falling back to scrcpy's virtual display (no window title bars on One UI 8.5+)."
      display=virtual
      local rebuilt=() a
      for a in "${args[@]}"; do
        if [ "$a" = "--display-id=OVERLAY" ]; then rebuilt+=("--new-display=$res/$dpi" --flex-display --no-vd-destroy-content); else rebuilt+=("$a"); fi
      done
      args=("${rebuilt[@]}")
    fi
  fi
  if [ "${OPT_DEBUG:-0}" = 1 ]; then debug_start "${args[@]}"; fi
  say "Starting Galaxy DeX ($profile, $TRANSPORT, $res @ $dpi dpi, screen: $screen, mouse: $mouse, display: $display, server: $SERVER_MODE)..."
  local modn; modn="$(mod_name "$mod")"
  say "${C_DIM}Resize the window freely. F11 = fullscreen, $modn+q quits. Frozen? Run: dex wake${C_OFF}"
  if [ "$profile" != "mirror" ] && [ "$mouse" = uhid ]; then
    say "${C_DIM}The DeX window captures the mouse (real HID mouse on the phone). Press $modn to give it back to the PC, click the window to capture again.${C_OFF}"
  fi
  local rc
  run_scrcpy "${args[@]}"; rc=$?
  trap - INT TERM
  restore_phone
  debug_stop
  case "$rc" in
    0) ok "DeX closed. Your apps moved back to the phone." ;;
    2) warn "The phone disconnected (cable unplugged, Wi-Fi dropped or the phone slept)." ;;
    *) err "scrcpy exited with code $rc." ;;
  esac
  return "$rc"
}

# --- other commands ----------------------------------------------------------------------
pair_hints() {
  cat >&2 <<EOF
Could not pair/connect. Check:
  - Phone and PC are on the same Wi-Fi network.
  - School Wi-Fi may isolate clients: use a PC hotspot (phone joins it) or the USB cable.
  - A phone hotspot does NOT work: Wireless debugging needs the phone to be a Wi-Fi client.
EOF
}

# after_wifi_connect [IP:PORT]: note the phone just connected so later sessions skip pairing.
# adb names a TCP device by its endpoint, so the endpoint is the serial to talk to.
after_wifi_connect() {
  local ep="${1:-$(cfg_get DEX_LAST_ENDPOINT)}"
  [ -n "$ep" ] || return 0
  SERIAL="$ep"; remember_phone
}

cmd_pair() {
  need_tools
  local rp
  if rp="$(remembered_phone)"; then
    say "Remembered phone: $rp. Pairing is only needed once per PC; checking if it is reachable..."
    if mdns_connect || saved_connect; then ok "Already paired and connected. Run: dex"; return 0; fi
    say "Not reachable. If Wireless debugging is on and only the port changed, use: dex connect"
    say "Continue to pair again (needed if the phone forgot this PC, e.g. after a PC reset)."
  fi
  cat <<EOF
Pair without a cable (once per PC):
  Phone > Settings > Developer options > Wireless debugging ON
  > "Pair device with pairing code".
EOF
  local pair="" code="" ep=""
  read -r -p "Pairing IP:port (shown in the dialog): " pair || true
  read -r -p "6-digit pairing code: " code || true
  if [ -z "$pair" ] || [ -z "$code" ]; then err "Need both the pairing IP:port and the code."; return 1; fi
  if ! "$ADB" pair "$pair" "$code"; then
    pair_hints; return 1
  fi
  say "Paired. Now the connect port (Wireless debugging main screen: \"IP address & Port\")."
  if ! mdns_connect; then
    read -r -p "Connect IP:port: " ep || true
    if [ -z "$ep" ]; then err "Need the connect IP:port."; return 1; fi
    if "$ADB" connect "$ep" 2>&1 | connected_ok; then
      save_endpoint "$ep"
    else
      pair_hints; return 1
    fi
  fi
  after_wifi_connect "$(cfg_get DEX_LAST_ENDPOINT)"
  ok "Connected and remembered. Next time: just run dex (or press c if the port changed). Run: dex"
}

cmd_connect() {
  need_tools
  local ep="${1:-}" ip
  if [ -z "$ep" ]; then
    if mdns_connect; then after_wifi_connect "$(cfg_get DEX_LAST_ENDPOINT)"; ok "Connected."; return 0; fi
    if saved_connect; then after_wifi_connect "$(cfg_get DEX_LAST_ENDPOINT)"; ok "Connected to $(cfg_get DEX_LAST_ENDPOINT)."; return 0; fi
    ip="$(cfg_get DEX_LAST_IP)"
    if [ -n "$ip" ]; then
      say "Remembered phone: $(remembered_phone). No pairing code needed, only the current port."
      read -r -p "Port or IP:port (Wireless debugging > \"IP address & Port\"): " ep || true
    else
      read -r -p "Phone IP:port (Wireless debugging screen): " ep || true
    fi
  fi
  if [ -z "$ep" ]; then err "No endpoint given. Try: dex pair"; return 1; fi
  ip="$(cfg_get DEX_LAST_IP)"
  case "$ep" in
    *:*) ;;
    *[!0-9]*) ep="$ep:5555" ;;      # an IP without a port: the dex wifi port
    *) if [ -n "$ip" ]; then ep="$ip:$ep"; else err "Only a port given but no remembered phone. Use IP:port."; return 1; fi ;;
  esac
  if "$ADB" connect "$ep" 2>&1 | connected_ok; then
    save_endpoint "$ep"
    after_wifi_connect "$ep"
    ok "Connected to $ep. Run: dex"
  else
    pair_hints; return 1
  fi
}

cmd_wifi() {
  need_tools
  scan_devices
  if [ -z "$USB_LIST" ]; then
    if [ -n "$UNAUTH" ]; then unauth_help; fi
    err "Plug the phone in with USB first."; return 2
  fi
  local s ip
  s="$(first_line "$USB_LIST")"
  "$ADB" -s "$s" tcpip 5555 >/dev/null
  sleep 2
  ip="$("$ADB" -s "$s" shell ip -f inet addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\)\/.*/\1/p' | head -n 1)"
  if [ -z "$ip" ]; then err "Could not read the phone's Wi-Fi IP. Is Wi-Fi on?"; return 1; fi
  if "$ADB" connect "$ip:5555" 2>&1 | connected_ok; then
    save_endpoint "$ip:5555"
    after_wifi_connect "$ip:5555"
    ok "Connected over Wi-Fi ($ip:5555). You can unplug the cable (works until the phone reboots)."
  else
    pair_hints; return 1
  fi
}

cmd_wake() {
  need_tools
  select_device "$MODE" || return 2
  # -d 0 targets the phone panel (Android 14+ needs the display id), the second call is the fallback.
  phone_shell input -d 0 keyevent KEYCODE_WAKEUP >/dev/null
  phone_shell input keyevent KEYCODE_WAKEUP >/dev/null
  ok "Wake-up sent. If the DeX window is still frozen: unlock the phone, or press Alt+Shift+r in the window."
}

cmd_keyboard() {
  need_tools
  select_device "$MODE" || return 2
  if ! "$ADB" -s "$SERIAL" shell am start -a android.settings.HARD_KEYBOARD_SETTINGS >/dev/null; then
    err "Could not open the keyboard settings on the phone."; return 1
  fi
  ok "Opened the keyboard settings on the phone. Pick Turkish Q as the layout."
}

one_ui_version() { # one_ui_version SERIAL -> "9.0" or ""
  local one
  one="$("$ADB" -s "$1" shell getprop ro.build.version.oneui 2>/dev/null | tr -d '\r')"
  case "$one" in [0-9]*) printf '%s.%s' "$(( one / 10000 ))" "$(( one % 10000 / 100 ))" ;; esac
}

cmd_doctor() {
  need_tools
  say "scrcpy: $("$SCRCPY" --version 2>/dev/null | head -n 1 || echo 'not runnable')"
  say "adb:    $("$ADB" version 2>/dev/null | head -n 1 || echo 'not runnable')"
  say "devices:"
  "$ADB" devices -l 2>/dev/null | sed 's/^/  /' || true
  scan_devices
  if [ -z "$USB_LIST$TCP_LIST" ]; then
    if [ -n "$UNAUTH" ]; then unauth_help; fi
    no_device_help; return 2
  fi
  local s model sdk ui wk
  s="$(first_line "$USB_LIST$TCP_LIST")"
  SERIAL="$s"
  model="$(phone_shell getprop ro.product.model)"
  sdk="$(phone_shell getprop ro.build.version.sdk)"
  ui="$(one_ui_version "$s")"
  say "phone:   ${model:-unknown} (Android SDK ${sdk:-?})"
  if [ -n "$ui" ]; then
    say "One UI:  $ui"
    if [ "${ui%%.*}" -lt 8 ]; then
      warn "One UI $ui is too old: DeX on a virtual display needs One UI 8+."
    else
      ok "One UI 8+ detected."
      case "$ui" in
        8.0) say "One UI 8.0: desktop windowing works out of the box." ;;
        *) say "One UI 8.5+/9: dex forces desktop windowing on the DeX display at start (the fix for fullscreen-only apps)." ;;
      esac
    fi
  else
    warn "Could not read One UI version (not a Samsung phone, or One UI < 8?)."
  fi
  wk="$(phone_shell dumpsys power | sed -n 's/.*mWakefulness=\([A-Za-z]*\).*/\1/p' | head -n 1)"
  [ -n "$wk" ] && say "power:   $wk"
  local ffs
  ffs="$(phone_shell settings get global enable_freeform_support)"
  local wff; wff="$(want_freeform_support)"
  say "freeform support: $ffs (dex sets it to ${wff:-<unchanged>} while DeX runs)"
  SERVER_MODE="$(want_server)"
  say "server:           $SERVER_MODE (patched = dex build with desktop-capable virtual display; file: $SERVER_PATCHED$([ -f "$SERVER_PATCHED" ] || printf ' MISSING'))"
  say "display mode:     $(want_display) (overlay = real desktop windows on One UI 8.5+/9; virtual = scrcpy display)"
  say "force desktop:    $(phone_shell settings get global force_desktop_mode_on_external_displays) (DEX_FORCE_DESKTOP=$(cfg_get DEX_FORCE_DESKTOP))"
  say "mouse mode:       $(want_mouse) (uhid = real HID mouse on the DeX display, needs Android 15+; sdk = injected touch)"
  say "mouse accel:      $(phone_shell settings get system mouse_pointer_acceleration_enabled) (dex turns it off while DeX runs with uhid unless DEX_MOUSE_ACCEL=1)"
  local rp
  if rp="$(remembered_phone)"; then say "remembered: $rp"; fi
  return 0
}

cmd_update() {
  if [ -n "${DEX_SOURCE_DIR:-}" ] && [ -f "$DEX_SOURCE_DIR/install.sh" ]; then
    exec bash "$DEX_SOURCE_DIR/install.sh"
  fi
  command -v curl >/dev/null 2>&1 || die "Need curl to update."
  curl -fsSL "https://raw.githubusercontent.com/$DEX_REPO/main/install.sh" | bash
}

cmd_uninstall() {
  if [ -x "$ROOT/scrcpy/adb" ]; then "$ROOT/scrcpy/adb" kill-server >/dev/null 2>&1 || true; fi
  # Remove only what dex created; DEX_HOME may point at a shared folder.
  rm -rf "$ROOT/scrcpy" "$CONFIG_DIR"
  rmdir "$ROOT" 2>/dev/null || true
  rm -f "$HOME/.local/share/applications/galaxy-dex.desktop" "$HOME/Applications/Galaxy DeX.command"
  local rc tmp
  for rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    tmp="$rc.dex.$$"
    grep -v '# dex$' "$rc" > "$tmp" || true
    cat "$tmp" > "$rc"
    rm -f "$tmp"
  done
  rm -f "$HOME/.local/bin/dex"
  ok "dex removed."
  exit 0
}

# --- interactive menu (TUI) -------------------------------------------------------------
# Box drawing needs a UTF-8 terminal; fall back to ASCII otherwise.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *UTF-8*|*utf-8*|*UTF8*|*utf8*) TL="╭"; TR="╮"; BL="╰"; BR="╯"; H="─"; V="│"; ML="├"; MR="┤"; ARROW="›"; DOT="·" ;;
  *) TL="+"; TR="+"; BL="+"; BR="+"; H="-"; V="|"; ML="+"; MR="+"; ARROW=">"; DOT="-" ;;
esac
BOX_W=58 # inner width
# bash 3.2 (macOS) cannot parse a quote inside a here-doc inside $(...), so read it directly.
IFS= read -r -d '' BANNER <<'EOF' || true
           _                   _
  ___ _ __| | ____ _        __| | _____  __
 / _ \ '__| |/ / _` |_____ / _` |/ _ \ \/ /
|  __/ |  |   < (_| |_____| (_| |  __/>  <
 \___|_|  |_|\_\__,_|      \__,_|\___/_/\_\
EOF
BANNER="${BANNER%$'\n'}"

term_cols() { local c="${COLUMNS:-}"; [ -n "$c" ] || c="$(tput cols 2>/dev/null || true)"; printf '%s' "${c:-80}"; }

hline() { # hline LEFT RIGHT
  local i=0 s=""
  while [ $i -lt $BOX_W ]; do s="$s$H"; i=$((i+1)); done
  printf '  %s%s%s%s%s\n' "$C_CYAN" "$1" "$s" "$2" "$C_OFF"
}
pad() { # pad TEXT WIDTH -> text padded with spaces to WIDTH characters (printf pads bytes, not UTF-8 chars)
  local t="$1" n=$(( $2 - ${#1} ))
  while [ $n -gt 0 ]; do t="$t "; n=$((n-1)); done
  printf '%s' "$t"
}
row() { # row TEXT [COLOR]
  printf '  %s%s%s %s%s%s %s%s%s\n' "$C_CYAN" "$V" "$C_OFF" "${2:-}" "$(pad "$1" $((BOX_W-2)))" "$C_OFF" "$C_CYAN" "$V" "$C_OFF"
}
row_item() { # row_item KEY LABEL DESC [MARK]
  local mark="${4:-}"
  printf '  %s%s%s  %s%s%s %s%s%s %s%s%s%s%s\n' "$C_CYAN" "$V" "$C_OFF" "$C_B$C_CYAN" "$(pad "$1" 2)" "$C_OFF" "$C_B" "$(pad "$2" 9)" "$C_OFF" "$(pad "$3" $((BOX_W-15-${#mark})))" "$C_OK$mark$C_OFF" "$C_CYAN" "$V" "$C_OFF"
}
row_kv() { # row_kv LABEL VALUE [COLOR] [RIGHT]
  local right="${4:-}"
  printf '  %s%s%s %s%s%s%s%s%s%s %s%s%s\n' "$C_CYAN" "$V" "$C_OFF" "$C_DIM" "$(pad "$1" 9)" "$C_OFF" "${3:-}" "$(pad "$2" $((BOX_W-11-${#right})))" "$C_OFF" "$C_DIM$right$C_OFF" "$C_CYAN" "$V" "$C_OFF"
}

TUI_MODEL=""; TUI_SERIAL_SEEN=""; TUI_MSG=""; TUI_MSG_C=""
tui_phone_status() { # sets TUI_PHONE (status text), TUI_PHONE_C (color), TUI_BATT
  TUI_PHONE="no phone: plug in USB, or p = pair"; TUI_PHONE_C="$C_ERR"; TUI_BATT=""
  local rp
  if rp="$(remembered_phone)"; then TUI_PHONE="not connected: $rp $DOT c = connect"; fi
  scan_devices
  local s="" transport="" ui="" lvl=""
  if [ -n "$USB_LIST" ]; then s="$(first_line "$USB_LIST")"; transport="USB"
  elif [ -n "$TCP_LIST" ]; then s="$(first_line "$TCP_LIST")"; transport="Wi-Fi"
  elif [ -n "$UNAUTH" ]; then TUI_PHONE="UNAUTHORIZED: accept the prompt on the phone"; TUI_PHONE_C="$C_WARN"; return
  elif [ -n "$NOPERM" ]; then TUI_PHONE="USB blocked by udev rule (d = doctor)"; TUI_PHONE_C="$C_WARN"; return
  fi
  [ -n "$s" ] || return
  SERIAL="$s"
  if [ "$s" != "$TUI_SERIAL_SEEN" ]; then
    TUI_MODEL="$(phone_shell getprop ro.product.marketname)"
    [ -n "$TUI_MODEL" ] || TUI_MODEL="$(phone_shell getprop ro.product.model)"
    ui="$(one_ui_version "$s")"
    [ -n "$ui" ] && TUI_MODEL="$TUI_MODEL $DOT One UI $ui"
    TUI_SERIAL_SEEN="$s"
  fi
  lvl="$(phone_shell dumpsys battery | sed -n 's/.*level: *\([0-9]*\).*/\1/p' | head -n 1)"
  [ -n "$lvl" ] && TUI_BATT="$lvl%"
  TUI_PHONE="${TUI_MODEL:-$s} $DOT $transport"; TUI_PHONE_C="$C_OK"
}

tui_frame() { # prints one full frame
  local ver screen fullscreen res dpi last cols line mouse
  ver="$("$SCRCPY" --version 2>/dev/null | head -n 1 | awk '{print $2}')"
  screen="$(cfg_get DEX_SCREEN)"; [ -n "$screen" ] || screen=on
  mouse="$(cfg_get DEX_MOUSE)"; [ -n "$mouse" ] || mouse="auto"
  local dmode; dmode="$(cfg_get DEX_DISPLAY)"; [ -n "$dmode" ] || dmode="auto"
  local smode; smode="$(cfg_get DEX_SERVER)"; [ -n "$smode" ] || smode="auto"
  if [ "$(cfg_get DEX_FULLSCREEN)" = 1 ]; then fullscreen="fullscreen"; else fullscreen="window"; fi
  res="$(cfg_get DEX_RES)"; [ -n "$res" ] || res="$(default_res 80) auto"
  dpi="$(cfg_get DEX_DPI)"; [ -n "$dpi" ] || dpi="auto"
  last="$(cfg_get DEX_LAST_PROFILE)"; case "$last" in code|school|movie|mirror) ;; *) last=code ;; esac
  cols="$(term_cols)"
  tui_phone_status
  say ""
  if [ "$cols" -ge 64 ]; then
    printf '%s\n' "$BANNER" | while IFS= read -r line; do printf '  %s%s%s\n' "$C_CYAN" "$line" "$C_OFF"; done
    say ""
  fi
  hline "$TL" "$TR"
  printf '  %s%s%s %s%s%s%s%s%s %s%s%s\n' "$C_CYAN" "$V" "$C_OFF" "$C_B" "$(pad "Galaxy DeX on your PC" $((BOX_W-2-${#ver}-7)))" "$C_OFF" "$C_DIM" "scrcpy $ver" "$C_OFF" "$C_CYAN" "$V" "$C_OFF"
  hline "$ML" "$MR"
  row_kv "Phone" "$TUI_PHONE" "$TUI_PHONE_C" "$TUI_BATT"
  row_kv "Settings" "phone $screen $DOT $fullscreen $DOT $dmode $DOT server $smode $DOT mouse $mouse $DOT $res @ $dpi"
  hline "$ML" "$MR"
  local m1="" m2="" m3="" m4=""
  case "$last" in code) m1="last " ;; school) m2="last " ;; movie) m3="last " ;; mirror) m4="last " ;; esac
  row_item 1 "Code" "$(profile_desc code)" "$m1"
  row_item 2 "School" "$(profile_desc school)" "$m2"
  row_item 3 "Movie" "$(profile_desc movie)" "$m3"
  row_item 4 "Mirror" "$(profile_desc mirror)" "$m4"
  row ""
  row_item p "Pair" "Wi-Fi pairing with a code (no cable)"
  row_item c "Connect" "reconnect over Wi-Fi"
  row_item w "Wi-Fi" "USB plugged in -> switch to Wi-Fi"
  row_item k "Keyboard" "phone keyboard layout (Turkish Q)"
  row_item s "Screen" "phone panel while DeX runs: on / dim / off"
  row_item f "Window" "toggle window / fullscreen start"
  row_item r "Size" "set window size and DPI"
  row_item m "Mouse" "real HID mouse (uhid) / injected touch (sdk)"
  row_item o "Display" "auto / overlay (One UI 9 windows) / virtual"
  row_item v "Server" "auto / patched (dex build) / stock scrcpy"
  row_item d "Doctor" "versions, devices, One UI check"
  row_item x "Wake" "unfreeze a stuck DeX window"
  row_item l "Log" "start Code with a phone log for bug reports"
  row_item u "Update" "re-run the installer"
  row_item q "Quit" ""
  hline "$BL" "$BR"
  if [ -n "$TUI_MSG" ]; then printf '  %s%s%s\n' "$TUI_MSG_C" "$TUI_MSG" "$C_OFF"; else printf '  %sEnter = %s %s F11 fullscreen in DeX %s Alt+q closes DeX %s menu refreshes itself%s\n' "$C_DIM" "$last" "$DOT" "$DOT" "$DOT" "$C_OFF"; fi
  printf '  Choose %s ' "$ARROW"
}
tui_draw() { # redraw in place (no flicker): home, print frame with clear-to-eol, clear the rest
  local line
  printf '\033[H'
  tui_frame | while IFS= read -r line; do printf '%s\033[K\n' "$line"; done
  printf '\033[1A\033[%dC\033[J' 11 # back onto the prompt line, after "  Choose > "
}
tui_msg() { TUI_MSG="$1"; TUI_MSG_C="${2:-$C_DIM}"; }

tui_pause() { say ""; printf '  %sPress any key to return to the menu...%s' "$C_DIM" "$C_OFF"; read -rsn1 _ || true; printf '\033[2J'; }

tui_run() { # tui_run FUNC ARGS... : run a command, then pause so the output can be read
  local rc
  printf '\033[H\033[2J'
  "$@"; rc=$?
  case "$rc" in
    0) ;;
    2) tui_msg "No phone found. Plug in USB, or press p to pair over Wi-Fi." "$C_WARN" ;;
    *) tui_msg "Last command exited with code $rc." "$C_WARN" ;;
  esac
  tui_pause
}

tui_menu() {
  need_tools
  local key last
  printf '\033[2J'
  while :; do
    tui_draw
    key=""
    if ! read -rsn1 -t 5 key; then
      [ -n "$key" ] || continue # timeout: refresh the phone status
    fi
    say ""
    case "$key" in
      "") last="$(cfg_get DEX_LAST_PROFILE)"; case "$last" in school|movie|mirror) ;; *) last=code ;; esac; tui_run start "$last" ;;
      1) tui_run start code ;;
      2) tui_run start school ;;
      3) tui_run start movie ;;
      4) tui_run start mirror ;;
      p|P) tui_run cmd_pair ;;
      c|C) tui_run cmd_connect ;;
      w|W) tui_run cmd_wifi ;;
      k|K) tui_run cmd_keyboard ;;
      d|D) tui_run cmd_doctor ;;
      x|X) tui_run cmd_wake ;;
      l|L) OPT_DEBUG=1; tui_run start code; OPT_DEBUG=0 ;;
      o|O)
        case "$(cfg_get DEX_DISPLAY)" in
          overlay) cfg_set DEX_DISPLAY virtual; tui_msg "Display: scrcpy virtual display (resizes with the window; no title bars on One UI 8.5+/9)." "$C_WARN" ;;
          virtual) cfg_set DEX_DISPLAY ""; tui_msg "Display: auto (overlay on One UI 8.5+/9, virtual otherwise)." "$C_OK" ;;
          *) cfg_set DEX_DISPLAY overlay; tui_msg "Display: overlay (real desktop windows; fixed size; preview on the phone screen)." "$C_OK" ;;
        esac ;;
      v|V)
        case "$(cfg_get DEX_SERVER)" in
          patched) cfg_set DEX_SERVER stock; tui_msg "Server: stock scrcpy server (virtual display has no title bars on One UI 8.5+/9; overlay mode works)." "$C_WARN" ;;
          stock) cfg_set DEX_SERVER ""; tui_msg "Server: auto (patched when installed and Android 17+)." "$C_OK" ;;
          *) if [ -f "$SERVER_PATCHED" ]; then cfg_set DEX_SERVER patched; tui_msg "Server: patched (desktop-capable virtual display: real windows, resizes with the window, no phone preview)." "$C_OK"; else tui_msg "Patched server not installed yet: press u (update) first." "$C_ERR"; fi ;;
        esac ;;
      m|M)
        case "$(cfg_get DEX_MOUSE)" in
          sdk) cfg_set DEX_MOUSE uhid; tui_msg "Mouse: real HID mouse on the DeX display (title bars drag like native DeX; Alt releases the pointer)." "$C_OK" ;;
          *) cfg_set DEX_MOUSE sdk; tui_msg "Mouse: injected touch-style clicks (pointer never captured; window title bars may not drag on One UI 8.5+)." "$C_WARN" ;;
        esac ;;
      u|U) cmd_update; return $? ;;
      h|H|'?') tui_run usage ;;
      s|S)
        case "$(cfg_get DEX_SCREEN)" in
          dim) cfg_set DEX_SCREEN off; tui_msg "Phone screen OFF while DeX runs. If DeX freezes, press x (wake) and switch back to on/dim." "$C_WARN" ;;
          off) cfg_set DEX_SCREEN on; tui_msg "Phone screen stays ON while DeX runs (safest)." "$C_OK" ;;
          *) cfg_set DEX_SCREEN dim; tui_msg "Phone screen DIMMED while DeX runs (brightness restored on exit)." "$C_OK" ;;
        esac ;;
      f|F)
        if [ "$(cfg_get DEX_FULLSCREEN)" = 1 ]; then cfg_set DEX_FULLSCREEN 0; tui_msg "DeX starts in a resizable window (F11 toggles fullscreen)." "$C_OK"
        else cfg_set DEX_FULLSCREEN 1; tui_msg "DeX starts fullscreen at your monitor's resolution, like a real DeX monitor." "$C_OK"; fi ;;
      r|R)
        local res dpi
        read -r -p "  Window size WxH (empty = auto, 80% of screen): " res || true
        read -r -p "  DPI (empty = profile default; 160 normal, 140 denser, 200 bigger): " dpi || true
        case "$res" in ""|[0-9]*x[0-9]*) ;; *) tui_msg "Size must look like 1600x900." "$C_ERR"; continue ;; esac
        case "$dpi" in ""|[0-9]*) ;; *) tui_msg "DPI must be a number." "$C_ERR"; continue ;; esac
        cfg_set DEX_RES "$res"; cfg_set DEX_DPI "$dpi"; tui_msg "Saved." "$C_OK"; printf '\033[2J' ;;
      q|Q|$'\e'|$'\x03') say ""; return 0 ;;
      *) tui_msg "Unknown key '$key'. Press 1-4 to start DeX, q to quit." ;;
    esac
  done
}

# --- main -------------------------------------------------------------------------------
MODE=auto; OPT_RES=""; OPT_DPI=""; OPT_SCREEN=""; OPT_FULLSCREEN=""; OPT_FREEFORM=""; OPT_MOUSE=""; OPT_DISPLAY=""; OPT_SERVER=""; OPT_DEBUG=0; OPT_RAW=()
CMD=""
if [ $# -gt 0 ]; then
  case "$1" in -*) ;; *) CMD="$1"; shift ;; esac
fi
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --res) [ $# -ge 2 ] || die "--res needs WxH"; OPT_RES="$2"; shift 2 ;;
    --res=*) OPT_RES="${1#*=}"; shift ;;
    --dpi) [ $# -ge 2 ] || die "--dpi needs a number"; OPT_DPI="$2"; shift 2 ;;
    --dpi=*) OPT_DPI="${1#*=}"; shift ;;
    --usb) MODE=usb; shift ;;
    --wifi) MODE=wifi; shift ;;
    --screen) [ $# -ge 2 ] || die "--screen needs on, dim or off"; OPT_SCREEN="$2"; shift 2 ;;
    --screen=*) OPT_SCREEN="${1#*=}"; shift ;;
    --screen-off) OPT_SCREEN=off; shift ;;
    --fullscreen) OPT_FULLSCREEN=1; shift ;;
    --no-freeform) OPT_FREEFORM=0; shift ;;
    --mouse) [ $# -ge 2 ] || die "--mouse needs uhid or sdk"; OPT_MOUSE="$2"; shift 2 ;;
    --mouse=*) OPT_MOUSE="${1#*=}"; shift ;;
    --display) [ $# -ge 2 ] || die "--display needs auto, overlay or virtual"; OPT_DISPLAY="$2"; shift 2 ;;
    --display=*) OPT_DISPLAY="${1#*=}"; shift ;;
    --server) [ $# -ge 2 ] || die "--server needs auto, patched or stock"; OPT_SERVER="$2"; shift 2 ;;
    --server=*) OPT_SERVER="${1#*=}"; shift ;;
    --debug) OPT_DEBUG=1; shift ;;
    --menu|--tui) CMD=menu; shift ;;
    -h|--help) CMD=help; shift ;;
    --) shift; OPT_RAW=("$@"); break ;;
    -*) die "Unknown option: $1 (see: dex help)" ;;
    *) POS+=("$1"); shift ;;
  esac
done
case "$OPT_RES" in ""|[0-9]*x[0-9]*) ;; *) die "--res must look like 1600x900" ;; esac
case "$OPT_DPI" in ""|[0-9]*) ;; *) die "--dpi must be a number" ;; esac
case "$OPT_SCREEN" in ""|on|dim|off) ;; *) die "--screen must be on, dim or off" ;; esac
case "$OPT_MOUSE" in ""|uhid|sdk) ;; *) die "--mouse must be uhid or sdk" ;; esac
case "$OPT_DISPLAY" in ""|auto|overlay|virtual) ;; *) die "--display must be auto, overlay or virtual" ;; esac
[ "$OPT_DISPLAY" != auto ] || OPT_DISPLAY=""
case "$OPT_SERVER" in ""|auto|patched|stock) ;; *) die "--server must be auto, patched or stock" ;; esac
[ "$OPT_SERVER" != auto ] || OPT_SERVER=""

if [ -z "$CMD" ]; then
  # No command: interactive menu on a terminal, otherwise the default profile (scripts, CI).
  if [ -t 0 ] && [ -t 1 ] && [ "${DEX_NO_TUI:-0}" != 1 ]; then CMD=menu; else CMD=code; fi
fi

case "$CMD" in
  menu) tui_menu ;;
  code|school|movie|mirror) start "$CMD" ;;
  debug) OPT_DEBUG=1; start code ;;
  pair) cmd_pair ;;
  connect) cmd_connect "${POS[0]:-}" ;;
  wifi) cmd_wifi ;;
  wake) cmd_wake ;;
  keyboard) cmd_keyboard ;;
  doctor) cmd_doctor ;;
  update) cmd_update ;;
  uninstall) cmd_uninstall ;;
  help) usage ;;
  *) err "Unknown command: $CMD"; usage >&2; exit 1 ;;
esac
